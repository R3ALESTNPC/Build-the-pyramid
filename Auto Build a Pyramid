-- Teleport Logic
tpBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local character = player.Character or player.CharacterAdded:Wait()
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local quarryRegion = workspace.Regions:FindFirstChild("Region:Quarry")
        
        if rootPart and quarryRegion then
            local targetCFrame = quarryRegion:IsA("Model") and quarryRegion:GetPivot() or (quarryRegion:IsA("BasePart") and quarryRegion.CFrame)
            if targetCFrame then
                rootPart.CFrame = targetCFrame + Vector3.new(0, 5, 0)
            end
        end
    end)
end)

-- Background Automation Loop (Handles Knit + Prompt Simulation)
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            local success, knit = pcall(function()
                return require(ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit)
            end)
            
            -- Handle Auto Place
            if getgenv().AutoPlaceRunning and success and knit then
                local pyramidService = knit.GetService("PyramidService")
                if pyramidService and pyramidService.RF and pyramidService.RF.Place then
                    pyramidService.RF.Place:InvokeServer(
                        1, 
                        3674, 
                        195, 
                        {3574, 3673, 3573, 3474, 3672, 3473, 3572, 3472}
                    )
                end
            end
            
            -- Handle Auto Pickup via ProximityPrompt / Workspace Interaction simulation
            if getgenv().AutoPickupRunning then
                -- Automatically fire any ProximityPrompts found inside the quarry region
                local quarryRegion = workspace.Regions:FindFirstChild("Region:Quarry")
                if quarryRegion then
                    for _, desc in ipairs(quarryRegion:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") then
                            fireproximityprompt(desc)
                        end
                    end
                end
                
                -- Also fire standard Knit Remote methods as backup
                if success and knit then
                    local blockService = knit.GetService("BlockService")
                    if blockService and blockService.RF and blockService.RF.Pickup then
                        blockService.RF.Pickup:InvokeServer(quarryRegion)
                    end
                end
            end
        end)
    end
end)
