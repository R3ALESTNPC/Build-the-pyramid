-- Delay Input Label
local delayLabel = Instance.new("TextLabel")
delayLabel.Size = UDim2.new(0.85, 0, 0, 20)
delayLabel.Position = UDim2.new(0.075, 0, 0.48, 0)
delayLabel.BackgroundTransparency = 1
delayLabel.Text = "Hatch Delay (Seconds):"
delayLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
delayLabel.TextSize = 12
delayLabel.Font = Enum.Font.GothamMedium
delayLabel.TextXAlignment = Enum.TextXAlignment.Left
delayLabel.Parent = frame

-- Delay Textbox (Where you type the time interval)
local delayBox = Instance.new("TextBox")
delayBox.Size = UDim2.new(0.85, 0, 0, 40)
delayBox.Position = UDim2.new(0.075, 0, 0.60, 0)
delayBox.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
delayBox.Text = "1" -- Default delay of 1 second
delayBox.TextColor3 = Color3.fromRGB(255, 255, 255)
delayBox.TextSize = 14
delayBox.Font = Enum.Font.GothamBold
delayBox.Parent = frame

local delayCorner = Instance.new("UICorner")
delayCorner.CornerRadius = UDim.new(0, 6)
delayCorner.Parent = delayBox

-- Toggle State Logic
getgenv().AutoHatchRunning = false

hatchBtn.MouseButton1Click:Connect(function()
    getgenv().AutoHatchRunning = not getgenv().AutoHatchRunning
    if getgenv().AutoHatchRunning then
        hatchBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        hatchBtn.Text = "Auto Hatch: ON"
    else
        hatchBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        hatchBtn.Text = "Auto Hatch: OFF"
    end
end)

-- Background Auto-Hatch Loop
task.spawn(function()
    while true do
        -- Read whatever number is typed in the box (default to 1 if empty or invalid)
        local waitTime = tonumber(delayBox.Text) or 1
        task.wait(waitTime)
        
        if getgenv().AutoHatchRunning then
            pcall(function()
                local knit = require(ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit)
                local petService = knit.GetService("PetService")
                
                if petService and petService.RF and petService.RF.Hatch then
                    petService.RF.Hatch:InvokeServer(table.unpack({
                        [1] = "Nile",
                        [2] = 3,
                    }))
                end
            end)
        end
    end
end)
