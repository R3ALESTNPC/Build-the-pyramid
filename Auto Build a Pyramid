-- Diagnostic Tool to Find Knit / Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

print("--- SCANNING REPLICATEDSTORAGE ---")
for _, child in ipairs(ReplicatedStorage:GetChildren()) do
    print("Found in ReplicatedStorage: " .. child.Name)
end

-- Check if Packages exists
local packages = ReplicatedStorage:FindFirstChild("Packages") or ReplicatedStorage:FindFirstChild("Shared")
if packages then
    print("--- SCANNING PACKAGES/SHARED FOLDERS ---")
    for _, child in ipairs(packages:GetDescendants()) do
        if child.Name:lower():find("knit") or child.Name:lower():find("pyramid") then
            print("Found potential match: " .. child:GetFullName())
        end
    end
else
    print("Packages folder not found directly in ReplicatedStorage.")
end
