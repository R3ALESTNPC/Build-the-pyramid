btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = toggleBtn

-- Toggle State Logic
getgenv().AutoFarmRunning = false

toggleBtn.MouseButton1Click:Connect(function()
    getgenv().AutoFarmRunning = not getgenv().AutoFarmRunning
    
    if getgenv().AutoFarmRunning then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80) -- Green = On
        toggleBtn.Text = "Auto Farm: ON"
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- Red = Off
        toggleBtn.Text = "Auto Farm: OFF"
    end
end)

-- Safe Background Automation Loop
task.spawn(function()
    while true do
        task.wait(1)
        if getgenv().AutoFarmRunning then
            pcall(function()
                -- Safely look for Knit and the PyramidService each cycle
                local packages = ReplicatedStorage:FindFirstChild("Packages")
                if packages then
                    local index = packages:FindFirstChild("_Index")
                    if index then
                        -- Dynamically search for the sleitnick knit folder
                        for _, folder in ipairs(index:GetChildren()) do
                            if folder.Name:match("sleitnick_knit") then
                                local knit = require(folder.knit)
                                if knit and knit.GetService then
                                    local pyramidService = knit.GetService("PyramidService")
                                    if pyramidService and pyramidService.RF and pyramidService.RF.Place then
                                        pyramidService.RF.Place:InvokeServer(table.unpack({
                                            [1] = 1,
                                            [2] = 3674,
                                            [3] = 195,
                                            [4] = {
                                                [1] = 3574,
                                                [2] = 3673,
                                                [3] = 3573,
                                                [4] = 3474,
                                                [5] = 3672,
                                                [6] = 3473,
                                                [7] = 3572,
                                                [8] = 3472,
                                            },
                                        }))
                                    end
                                end
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
end)
