-- Debug Auto-Farm GUI
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

print("Script started loading...")

-- Use PlayerGui instead of CoreGui to ensure visibility
local playerGui = player:WaitForChild("PlayerGui")

if playerGui:FindFirstChild("PyramidAutoGui") then
    playerGui.PyramidAutoGui:Destroy()
end

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PyramidAutoGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Create Main Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 120)
frame.Position = UDim2.new(0.1, 0, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- Title Label
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "Auto Build Menu"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 16
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

-- Toggle Button
local button = Instance.new("TextButton")
button.Size = UDim2.new(0.85, 0, 0, 50)
button.Position = UDim2.new(0.075, 0, 0.4, 0)
button.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Red = Off
button.Text = "Auto Farm: OFF"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 16
button.Font = Enum.Font.SourceSansBold
button.Parent = frame

print("GUI created successfully!")

-- Toggle Logic
getgenv().AutoFarmRunning = false

button.MouseButton1Click:Connect(function()
    getgenv().AutoFarmRunning = not getgenv().AutoFarmRunning
    
    if getgenv().AutoFarmRunning then
        button.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Green = On
        button.Text = "Auto Farm: ON"
    else
        button.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Red = Off
        button.Text = "Auto Farm: OFF"
    end
end)

-- Background loop
task.spawn(function()
    local success, Knit = pcall(function()
        return require(ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit)
    end)
    
    if not success or not Knit then
        warn("Failed to load Knit framework!")
        return
    end
    
    Knit.OnStart():andThen(function()
        local PyramidService = Knit.GetService("PyramidService")

        while true do
            task.wait(1)
            if getgenv().AutoFarmRunning then
                pcall(function()
                    PyramidService.RF.Place:InvokeServer(table.unpack({
                        [1] = 1,
                        [2] = 3674,
                        [3] = 195,
                        [4] = {
                            [1] = 3574,
                            [2] = 3673,
                            [3] = 3573,
                            [4] = 3474,
                            [5] = 3672,
                            [6] = 3473,
                            [7] = 3572,
                            [8] = 3472,
                        },
                    }))
                end)
            end
        end
    end):catch(warn)
end)
