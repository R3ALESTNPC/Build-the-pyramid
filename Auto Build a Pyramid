-- Toggle States
getgenv().AutoPlaceRunning = false
getgenv().AutoPickupRunning = false

placeBtn.MouseButton1Click:Connect(function()
    getgenv().AutoPlaceRunning = not getgenv().AutoPlaceRunning
    if getgenv().AutoPlaceRunning then
        placeBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        placeBtn.Text = "Auto Place: ON"
    else
        placeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        placeBtn.Text = "Auto Place: OFF"
    end
end)

pickupBtn.MouseButton1Click:Connect(function()
    getgenv().AutoPickupRunning = not getgenv().AutoPickupRunning
    if getgenv().AutoPickupRunning then
        pickupBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        pickupBtn.Text = "Auto Pickup: ON"
    else
        pickupBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        pickupBtn.Text = "Auto Pickup: OFF"
    end
end)

-- Background Automation Loops
task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local knit = require(ReplicatedStorage.Packages._Index["sleitnick_knit@1.7.0"].knit)
            
            -- Handle Auto Place
            if getgenv().AutoPlaceRunning and knit then
                local pyramidService = knit.GetService("PyramidService")
                if pyramidService and pyramidService.RF and pyramidService.RF.Place then
                    pyramidService.RF.Place:InvokeServer(
                        1, 
                        3674, 
                        195, 
                        {3574, 3673, 3573, 3474, 3672, 3473, 3572, 3472}
                    )
                end
            end
            
            -- Handle Auto Pickup & CarryStateChanged RemoteEvent
            if getgenv().AutoPickupRunning and knit then
                local blockService = knit.GetService("BlockService")
                
                -- Invoke the RemoteFunction pickup
                if blockService and blockService.RF and blockService.RF.Pickup then
                    blockService.RF.Pickup:InvokeServer(workspace.Regions["Region:Quarry"])
                end
                
                -- Fire the RemoteEvent / CarryStateChanged if present
                if blockService and blockService.RE and blockService.RE.CarryStateChanged then
                    blockService.RE.CarryStateChanged:FireServer("19:190:0:0:0:0:0:0")
                end
            end
        end)
    end
end)
